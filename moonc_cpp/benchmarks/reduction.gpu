# Benchmark 4: Reducao Paralela (Soma)
# Avalia sincronizacao de threads e memoria compartilhada
# Metrica: Tempo de Execucao e Escalabilidade

cuda kernel def reduction_sum(input, output, n) {
    # Memoria compartilhada por bloco
    shared = shared[256]
    tid = threadIdx_x
    i = blockIdx_x * blockDim_x + tid
    
    # Carregar dados em shared memory
    if (i < n) {
        shared[tid] = input[i]
    } else {
        shared[tid] = 0.0
    }
    syncthreads()  # Sincronizar threads do bloco
    
    # Reducao em arvore
    s = 128
    while (s > 0) {
        if (tid < s) {
            shared[tid] = shared[tid] + shared[tid + s]
        }
        syncthreads()
        s = s / 2
    }
    
    # Escrever resultado
    if (tid == 0) {
        output[blockIdx_x] = shared[0]
    }
}

def main() {
    n = 1000000  # 1M elementos
    threads_per_block = 256
    blocks = (n + threads_per_block - 1) / threads_per_block
    
    # Alocar memoria CPU
    h_input = [0.0] * n
    h_output = [0.0] * blocks
    
    # Inicializar
    for (i = 0; i < n; i = i + 1) {
        h_input[i] = 1.0
    }
    
    # Alocar GPU
    d_input = device[n]
    d_output = device[blocks]
    
    # Transfer H->D
    d_input <- h_input
    
    # Launch kernel
    gpu[blocks, threads_per_block] reduction_sum(d_input, d_output, n)
    
    # Transfer D->H
    h_output <- d_output
    
    # Soma parcial (em CPU por enquanto)
    total = 0.0
    for (i = 0; i < blocks; i = i + 1) {
        total = total + h_output[i]
    }
    
    print("Reducao concluida!")
    print("Elementos:", n)
    print("Blocos:", blocks)
    print("Soma parcial:", total)
    print("Esperado:", float(n))
    
    # Cleanup
    free(d_input)
    free(d_output)
}

main()

