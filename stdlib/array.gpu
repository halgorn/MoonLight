# MoonLight Standard Library - Array Module
# Operações com arrays e listas

def reverse(lista) {
    n = len(lista)
    reversed = []
    
    i = n - 1
    while (i >= 0) {
        reversed = reversed + [lista[i]]
        i = i - 1
    }
    
    return reversed
}

def sort(lista) {
    n = len(lista)
    sorted = lista
    
    # Bubble sort
    for (i = 0; i < n; i = i + 1) {
        for (j = 0; j < n - 1; j = j + 1) {
            if (sorted[j] > sorted[j + 1]) {
                temp = sorted[j]
                sorted[j] = sorted[j + 1]
                sorted[j + 1] = temp
            }
        }
    }
    
    return sorted
}

def filter_list(lista, predicate) {
    filtered = []
    
    for (i = 0; i < len(lista); i = i + 1) {
        if (predicate(lista[i])) {
            filtered = filtered + [lista[i]]
        }
    }
    
    return filtered
}

def map_list(lista, transform) {
    mapped = []
    
    for (i = 0; i < len(lista); i = i + 1) {
        mapped = mapped + [transform(lista[i])]
    }
    
    return mapped
}

def reduce_list(lista, accumulator, initial) {
    result = initial
    
    for (i = 0; i < len(lista); i = i + 1) {
        result = accumulator(result, lista[i])
    }
    
    return result
}

def find(lista, value) {
    for (i = 0; i < len(lista); i = i + 1) {
        if (lista[i] == value) {
            return i
        }
    }
    return -1
}

def contains(lista, value) {
    return find(lista, value) != -1
}

def count(lista, value) {
    counter = 0
    
    for (i = 0; i < len(lista); i = i + 1) {
        if (lista[i] == value) {
            counter = counter + 1
        }
    }
    
    return counter
}

def unique(lista) {
    result = []
    
    for (i = 0; i < len(lista); i = i + 1) {
        if (not contains(result, lista[i])) {
            result = result + [lista[i]]
        }
    }
    
    return result
}

def flatten(lista) {
    result = []
    
    for (i = 0; i < len(lista); i = i + 1) {
        item = lista[i]
        result = result + item
    }
    
    return result
}

def chunk(lista, size) {
    chunks = []
    current = []
    
    for (i = 0; i < len(lista); i = i + 1) {
        current = current + [lista[i]]
        
        if (len(current) == size) {
            chunks = chunks + [current]
            current = []
        }
    }
    
    if (len(current) > 0) {
        chunks = chunks + [current]
    }
    
    return chunks
}

def zip_lists(lista1, lista2) {
    result = []
    n = min(len(lista1), len(lista2))
    
    for (i = 0; i < n; i = i + 1) {
        result = result + [[lista1[i], lista2[i]]]
    }
    
    return result
}

def all_true(lista) {
    for (i = 0; i < len(lista); i = i + 1) {
        if (not lista[i]) {
            return False
        }
    }
    return True
}

def any_true(lista) {
    for (i = 0; i < len(lista); i = i + 1) {
        if (lista[i]) {
            return True
        }
    }
    return False
}










