# MoonLight AI - Optimizers
# Gradient descent optimizers for training neural networks

class Optimizer {
    # Base optimizer class
    def __init__(parameters, lr) {
        self.parameters = parameters
        self.lr = lr
    }
    
    def zero_grad() {
        # Reset gradients
        for (i = 0; i < len(self.parameters); i = i + 1) {
            param = self.parameters[i]
            param.grad = None
        }
    }
    
    def step() {
        # Must be implemented by subclasses
        pass
    }
}

class SGD {
    # Stochastic Gradient Descent
    def __init__(parameters, lr, momentum, weight_decay) {
        self.parameters = parameters
        self.lr = lr
        self.momentum = momentum
        self.weight_decay = weight_decay
        self.velocity = []
        
        # Initialize velocity for momentum
        if (momentum > 0.0) {
            for (i = 0; i < len(parameters); i = i + 1) {
                self.velocity = self.velocity + [0.0]
            }
        }
        
        print("SGD optimizer created with lr=", lr)
    }
    
    def zero_grad() {
        for (i = 0; i < len(self.parameters); i = i + 1) {
            param = self.parameters[i]
            param.grad = None
        }
    }
    
    def step() {
        # Update parameters: θ = θ - lr * ∇θ
        for (i = 0; i < len(self.parameters); i = i + 1) {
            param = self.parameters[i]
            
            if (param.grad == None) {
                continue
            }
            
            grad = param.grad
            
            # Weight decay (L2 regularization)
            if (self.weight_decay > 0.0) {
                grad = grad + self.weight_decay * param.data
            }
            
            # Momentum
            if (self.momentum > 0.0) {
                self.velocity[i] = self.momentum * self.velocity[i] + grad
                grad = self.velocity[i]
            }
            
            # Update
            param.data = param.data - self.lr * grad
        }
    }
}

class Adam {
    # Adam optimizer (Adaptive Moment Estimation)
    def __init__(parameters, lr, betas, eps, weight_decay) {
        self.parameters = parameters
        self.lr = lr
        self.beta1 = betas[0]
        self.beta2 = betas[1]
        self.eps = eps
        self.weight_decay = weight_decay
        
        # Initialize moments
        self.m = []  # First moment (mean)
        self.v = []  # Second moment (variance)
        self.t = 0   # Time step
        
        for (i = 0; i < len(parameters); i = i + 1) {
            self.m = self.m + [0.0]
            self.v = self.v + [0.0]
        }
        
        print("Adam optimizer created with lr=", lr)
    }
    
    def zero_grad() {
        for (i = 0; i < len(self.parameters); i = i + 1) {
            param = self.parameters[i]
            param.grad = None
        }
    }
    
    def step() {
        self.t = self.t + 1
        
        for (i = 0; i < len(self.parameters); i = i + 1) {
            param = self.parameters[i]
            
            if (param.grad == None) {
                continue
            }
            
            grad = param.grad
            
            # Weight decay
            if (self.weight_decay > 0.0) {
                grad = grad + self.weight_decay * param.data
            }
            
            # Update biased first moment estimate
            self.m[i] = self.beta1 * self.m[i] + (1.0 - self.beta1) * grad
            
            # Update biased second raw moment estimate
            self.v[i] = self.beta2 * self.v[i] + (1.0 - self.beta2) * grad * grad
            
            # Bias correction
            m_hat = self.m[i] / (1.0 - self.beta1 ** self.t)
            v_hat = self.v[i] / (1.0 - self.beta2 ** self.t)
            
            # Update parameters
            param.data = param.data - self.lr * m_hat / (sqrt(v_hat) + self.eps)
        }
    }
}

class AdamW {
    # Adam with decoupled weight decay
    def __init__(parameters, lr, betas, eps, weight_decay) {
        self.adam = Adam(parameters, lr, betas, eps, 0.0)
        self.weight_decay = weight_decay
    }
    
    def zero_grad() {
        self.adam.zero_grad()
    }
    
    def step() {
        # Decoupled weight decay
        for (i = 0; i < len(self.adam.parameters); i = i + 1) {
            param = self.adam.parameters[i]
            if (self.weight_decay > 0.0) {
                param.data = param.data - self.adam.lr * self.weight_decay * param.data
            }
        }
        
        # Adam step
        self.adam.step()
    }
}









