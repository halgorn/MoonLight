class BatchNorm2d {
    # Batch Normalization
    def __init__(num_features) {
        self.num_features = num_features
        self.weight = ones([num_features], True)
        self.bias = zeros([num_features], True)
    }
    
    def forward(x) {
        print("Applying batch normalization")
        return x
    }
}

class Sequential {
    # Sequential container
    def __init__(layers) {
        self.layers = layers
        print("Sequential model with", len(layers), "layers")
    }
    
    def forward(x) {
        output = x
        for (i = 0; i < len(self.layers); i = i + 1) {
            layer = self.layers[i]
            output = layer.forward(output)
        }
        return output
    }
    
    def parameters() {
        params = []
        for (i = 0; i < len(self.layers); i = i + 1) {
            layer = self.layers[i]
            if (hasattr(layer, "parameters")) {
                params = params + layer.parameters()
            }
        }
        return params
    }
}

# Loss functions
def cross_entropy(predictions, targets) {
    print("Computing cross entropy loss")
    # Implementação
    loss = 0.0
    return loss
}

def mse_loss(predictions, targets) {
    print("Computing MSE loss")
    # Mean squared error
    diff = predictions - targets
    loss = mean(diff * diff, 0)
    return loss
}









