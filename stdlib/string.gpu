# MoonLight Standard Library - String Module
# Manipulação de strings (básico, pois strings são limitadas no parser atual)

def string_length(s) {
    return len(s)
}

def repeat_string(s, n) {
    result = ""
    for (i = 0; i < n; i = i + 1) {
        result = result + s
    }
    return result
}

