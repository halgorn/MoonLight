# Verificação de Números Primos em MoonLight

def is_prime(n) {
    if (n <= 1) {
        return False
    }
    if (n == 2) {
        return True
    }
    for (i = 2; i < n; i = i + 1) {
        if (n % i == 0) {
            return False
        }
    }
    return True
}

print("Números primos até 50:")
count = 0
for (num = 2; num <= 50; num = num + 1) {
    if (is_prime(num)) {
        print(num)
        count = count + 1
    }
}
print("Total de primos encontrados:", count)










