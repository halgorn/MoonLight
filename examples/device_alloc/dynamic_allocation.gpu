# MoonLight Example: Dynamic Allocation on GPU
# Demonstrates malloc/free within CUDA kernels
# Memory allocated and freed entirely on the GPU!

cuda kernel def dynamic_allocator_kernel(input_data, output_data, n, temp_size) {
    tid = threadIdx_x + blockIdx_x * blockDim_x
    
    if (tid < n) {
        # Allocate temporary memory ON THE GPU!
        temp = device_malloc(temp_size * sizeof(float))
        
        if (temp != nullptr) {
            # Use temporary memory
            for (i = 0; i < temp_size; i = i + 1) {
                temp[i] = input_data[tid] * i
            }
            
            # Compute result using temp
            sum = 0
            for (i = 0; i < temp_size; i = i + 1) {
                sum = sum + temp[i]
            }
            
            output_data[tid] = sum
            
            # Free temporary memory ON THE GPU!
            device_free(temp)
        } else {
            # Allocation failed
            output_data[tid] = -1
        }
    }
}

def main() {
    print("=== Dynamic Allocation on GPU ===")
    print("")
    print("Demonstrates malloc/free within CUDA kernels")
    print("All memory operations happen on GPU - no CPU involved!")
    print("")
    
    n = 10000
    temp_size = 100
    
    print("Configuration:")
    print("  Elements:", n)
    print("  Temp size per element:", temp_size)
    print("  Total temp memory:", n * temp_size, "floats")
    print("")
    
    # Allocate input/output on GPU (host-side allocation)
    d_input = device[n]
    d_output = device[n]
    
    # Initialize input (in real app: cudaMemcpy)
    print("Initializing input data...")
    print("")
    
    # Launch kernel with dynamic allocation
    print("Launching kernel with dynamic allocation...")
    blocks = (n + 255) / 256
    threads = 256
    
    gpu[blocks, threads] dynamic_allocator_kernel(d_input, d_output, n, temp_size)
    
    print("✓ Kernel completed")
    print("  All allocations/frees happened on GPU!")
    print("")
    
    # Read results (in real app: cudaMemcpy)
    print("Results:")
    print("  All processing done on GPU")
    print("  Dynamic allocation working!")
    print("")
    
    print("Benefits:")
    print("  ✓ Allocate memory within kernels")
    print("  ✓ No CPU involvement for allocation")
    print("  ✓ Flexible memory usage")
    print("  ✓ Perfect for: variable-size data, temporary buffers")
    print("")
    
    # Cleanup
    free(d_input)
    free(d_output)
    
    print("Done!")
}

main()

