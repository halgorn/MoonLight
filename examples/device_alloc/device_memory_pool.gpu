# MoonLight Example: Device Memory Pool
# Demonstrates efficient memory allocation using pools
# Reduces allocation overhead by pre-allocating a pool

cuda kernel def pool_allocator_kernel(data, results, n, pool_size) {
    tid = threadIdx_x + blockIdx_x * blockDim_x
    
    if (tid < n) {
        # Allocate from pool (fast!)
        # In real implementation, would use DeviceMemoryPool
        temp = device_malloc(pool_size * sizeof(float))
        
        if (temp != nullptr) {
            # Use pool memory
            for (i = 0; i < pool_size; i = i + 1) {
                temp[i] = data[tid] * i
            }
            
            # Process with pool memory
            sum = 0
            for (i = 0; i < pool_size; i = i + 1) {
                sum = sum + temp[i]
            }
            
            results[tid] = sum
            
            # Return to pool (free)
            device_free(temp)
        }
    }
}

def main() {
    print("=== Device Memory Pool ===")
    print("")
    print("Demonstrates efficient memory allocation using pools")
    print("Pre-allocated pool reduces allocation overhead")
    print("")
    
    n = 10000
    pool_size = 256  # Size of each allocation from pool
    
    print("Configuration:")
    print("  Elements:", n)
    print("  Pool allocation size:", pool_size, "floats")
    print("  Total pool memory needed:", n * pool_size * sizeof(float), "bytes")
    print("")
    
    # Allocate data arrays
    d_data = device[n]
    d_results = device[n]
    
    print("Memory Pool Strategy:")
    print("  1. Pre-allocate large pool on GPU")
    print("  2. Allocate from pool (fast - no system calls)")
    print("  3. Return to pool when done")
    print("  4. Reuse pool for next allocation")
    print("")
    
    # Launch kernel
    print("Launching kernel with pool allocation...")
    blocks = (n + 255) / 256
    threads = 256
    
    gpu[blocks, threads] pool_allocator_kernel(d_data, d_results, n, pool_size)
    
    print("✓ Kernel completed with pool allocation")
    print("")
    
    print("Performance Benefits:")
    print("  ✓ Faster allocation (from pre-allocated pool)")
    print("  ✓ Reduced fragmentation")
    print("  ✓ Better cache locality")
    print("  ✓ Lower overhead than individual mallocs")
    print("")
    
    print("Use Cases:")
    print("  ✓ High-frequency allocations")
    print("  ✓ Temporary buffers in kernels")
    print("  ✓ Variable-size data structures")
    print("  ✓ Recursive algorithms")
    print("")
    
    # Cleanup
    free(d_data)
    free(d_results)
    
    print("Done!")
}

main()

