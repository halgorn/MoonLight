# MoonLight Example: Pinned Memory (Zero-Copy)
# Demonstrates pinned (page-locked) memory for fast transfers
# Enables DMA transfers without CPU involvement

cuda kernel def process_pinned_kernel(data, results, n) {
    tid = threadIdx_x + blockIdx_x * blockDim_x
    
    if (tid < n) {
        # Process pinned memory data
        results[tid] = data[tid] * data[tid]
    }
}

def main() {
    print("=== Pinned Memory (Zero-Copy) ===")
    print("")
    print("Demonstrates pinned memory for fast DMA transfers")
    print("Page-locked memory enables zero-copy transfers")
    print("")
    
    n = 1000000
    
    # Allocate pinned memory
    # Page-locked for fast DMA transfers
    pinned_data = pinned memory[n]
    pinned_results = pinned memory[n]
    
    print("Configuration:")
    print("  Size:", n, "elements")
    print("  Type: Pinned (page-locked) memory")
    print("")
    
    # Initialize pinned memory
    print("Step 1: Initialize pinned memory")
    for (i = 0; i < n; i = i + 1) {
        pinned_data[i] = i * 0.01
    }
    print("  ✓ Initialized", n, "elements")
    print("")
    
    # Transfer to GPU (fast DMA - no CPU copy!)
    print("Step 2: Transfer to GPU (DMA)")
    print("  Pinned memory enables DMA transfer")
    print("  No CPU involvement - direct GPU access!")
    print("")
    
    # GPU processes
    print("Step 3: GPU processes data")
    blocks = (n + 255) / 256
    threads = 256
    
    gpu[blocks, threads] process_pinned_kernel(pinned_data, pinned_results, n)
    
    print("  ✓ GPU processing complete")
    print("")
    
    # Transfer back (fast DMA)
    print("Step 4: Transfer back (DMA)")
    print("  Fast DMA transfer back to CPU")
    print("")
    
    # Read results
    sum = 0.0
    for (i = 0; i < 10; i = i + 1) {
        sum = sum + pinned_results[i]
    }
    
    print("  ✓ Results transferred back")
    print("")
    
    print("Performance Benefits:")
    print("  ✓ Faster transfers (DMA vs CPU copy)")
    print("  ✓ Can overlap with computation")
    print("  ✓ Lower CPU overhead")
    print("  ✓ Better for: large transfers, streaming")
    print("")
    
    print("Comparison:")
    print("  Regular memory:")
    print("    - CPU copies to pinned buffer")
    print("    - Then transfers to GPU")
    print("    - Two-step process")
    print("")
    print("  Pinned memory:")
    print("    - Direct DMA transfer")
    print("    - One-step process")
    print("    - 2-3x faster for large transfers")
    print("")
    
    print("Use Cases:")
    print("  ✓ Large data transfers")
    print("  ✓ Streaming workloads")
    print("  ✓ Overlapping transfers with computation")
    print("  ✓ High-bandwidth requirements")
    print("")
    
    # Cleanup
    free(pinned_data)
    free(pinned_results)
    
    print("Done!")
}

main()

