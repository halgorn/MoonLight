# examples/cli/hello_cli.gpu
# Exemplo simples para teste do CLI

print("=== MoonLight CLI Demo ===")

def greet(name) {
    return "Hello, " + name + "!"
}

message = greet("World")
print(message)

# Teste de operações matemáticas
x = 10
y = 20
sum_result = x + y

print("10 + 20 =", sum_result)

# Teste de loop
print("Contando até 5:")
i = 1
while (i <= 5) {
    print(i)
    i = i + 1
}

print("=== Demo Completa ===")









