# Exemplo de Unpacking em MoonLight

# Unpacking básico
a, b = [1, 2]
print("a =", a)
print("b =", b)

# Unpacking de lista maior
x, y, z = [10, 20, 30]
print("x =", x, ", y =", y, ", z =", z)

# Multiple assignment
i = j = k = 0
print("i =", i, ", j =", j, ", k =", k)

# Swap com unpacking
p = 5
q = 10
print("Antes: p =", p, ", q =", q)
p, q = [q, p]
print("Depois: p =", p, ", q =", q)










