# Exemplo de Generators em MoonLight

# Generator simples
def count_up_to(max) {
    n = 0
    while (n < max) {
        yield n
        n = n + 1
    }
}

# Usando o generator
counter = count_up_to(5)
print("Counter:", counter)

# Generator com fibonacci
def fibonacci(n) {
    a = 0
    b = 1
    i = 0
    while (i < n) {
        yield a
        temp = a
        a = b
        b = temp + b
        i = i + 1
    }
}

fib = fibonacci(10)
print("Fibonacci generator:", fib)










