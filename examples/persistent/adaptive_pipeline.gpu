# MoonLight Example: Adaptive Pipeline with Auto-Balancing
# Pipeline that monitors throughput and adapts thread allocation
# Demonstrates dynamic workload balancing

# Shared metrics structure (in real implementation)
# For demo, we simulate with counters

cuda persistent kernel def producer_stage(output_queue, num_items) {
    tid = threadIdx_x + blockIdx_x * blockDim_x
    items_produced = 0
    
    # Each thread produces items
    items_per_thread = num_items / (blockDim_x * gridDim_x)
    
    for (i = 0; i < items_per_thread; i = i + 1) {
        item = tid * 1000 + i
        enqueue(output_queue, item, tid)
        items_produced = items_produced + 1
    }
    
    # Signal completion
    if (tid == 0) {
        enqueue(output_queue, -1, tid)
    }
}

cuda persistent kernel def compute_stage(input_queue, output_queue) {
    tid = threadIdx_x + blockIdx_x * blockDim_x
    items_processed = 0
    
    while (true) {
        item = dequeue_wait(input_queue)
        
        if (item == -1) {
            # Forward stop signal
            if (tid == 0) {
                enqueue(output_queue, -1, tid)
            }
            break
        }
        
        # Simulate heavy computation
        result = item * item
        for (j = 0; j < 100; j = j + 1) {
            result = result + j
        }
        
        enqueue(output_queue, result, tid)
        items_processed = items_processed + 1
    }
}

cuda persistent kernel def consumer_stage(input_queue, num_items) {
    tid = threadIdx_x + blockIdx_x * blockDim_x
    items_consumed = 0
    
    while (items_consumed < num_items) {
        item = dequeue_wait(input_queue)
        
        if (item == -1) {
            break
        }
        
        # Process final result
        final = item + tid
        
        items_consumed = items_consumed + 1
    }
}

def test_pipeline_configuration(producer_blocks, compute_blocks, consumer_blocks, num_items) {
    print("Testing configuration:")
    print("  Producer:", producer_blocks, "blocks")
    print("  Compute:", compute_blocks, "blocks")
    print("  Consumer:", consumer_blocks, "blocks")
    print("  Items:", num_items)
    
    # Create queues
    producer_output = gpu_queue[int, 10000]
    consumer_input = gpu_queue[int, 10000]
    
    # Launch pipeline
    gpu[producer_blocks, 256] producer_stage(producer_output, num_items)
    gpu[compute_blocks, 256] compute_stage(producer_output, consumer_input)
    gpu[consumer_blocks, 256] consumer_stage(consumer_input, num_items)
    
    print("  ✓ Pipeline running...")
    print("")
}

def main() {
    print("=== Adaptive Pipeline Demo ===")
    print("")
    print("Testing different pipeline configurations")
    print("Finding optimal thread allocation")
    print("")
    
    num_items = 10000
    
    # Test 1: Balanced configuration
    print("Configuration 1: Balanced")
    test_pipeline_configuration(4, 4, 4, num_items)
    
    # Test 2: Compute-heavy configuration
    print("Configuration 2: Compute-Heavy")
    test_pipeline_configuration(2, 16, 2, num_items)
    
    # Test 3: Producer-heavy configuration
    print("Configuration 3: Producer-Heavy")
    test_pipeline_configuration(8, 8, 2, num_items)
    
    print("=== Analysis ===")
    print("")
    print("Optimal Configuration:")
    print("  - Identify bottleneck stage")
    print("  - Allocate more threads to bottleneck")
    print("  - Monitor queue depths")
    print("  - Dynamically adjust allocation")
    print("")
    
    print("Auto-Balancing Strategy:")
    print("  1. Monitor queue depths")
    print("  2. If queue growing -> bottleneck detected")
    print("  3. Increase threads for bottleneck stage")
    print("  4. Decrease threads for idle stages")
    print("  5. Repeat until balanced")
    print("")
    
    print("Benefits:")
    print("  ✓ Maximum throughput")
    print("  ✓ Efficient resource usage")
    print("  ✓ Adapts to workload changes")
    print("  ✓ No manual tuning needed")
    print("")
    
    print("Done!")
}

main()

