# Declarative Pipeline Example
# Shows new pipeline syntax for easier multi-stage processing

class Data {
    def __init__(id, value) {
        self.id = id
        self.value = value
    }
}

# Define stages as persistent kernels
cuda persistent kernel def stage_preprocess(input_q, output_q) {
    while (true) {
        data = dequeue_wait(input_q)
        if (data.id == -1) { break }
        
        # Normalize
        normalized = Data(data.id, data.value / 100.0)
        enqueue(output_q, normalized)
    }
}

cuda persistent kernel def stage_compute(input_q, output_q) {
    while (true) {
        data = dequeue_wait(input_q)
        if (data.id == -1) { break }
        
        # Complex computation
        result = Data(data.id, data.value * data.value)
        enqueue(output_q, result)
    }
}

cuda persistent kernel def stage_postprocess(input_q, output_q) {
    while (true) {
        data = dequeue_wait(input_q)
        if (data.id == -1) { break }
        
        # Denormalize
        final = Data(data.id, data.value * 100.0)
        enqueue(output_q, final)
    }
}

def main() {
    print("=== Declarative Pipeline Example ===")
    print("Demonstrates cleaner pipeline syntax")
    print("")
    
    n_items = 1000
    
    # Create queues manually (Week 3 will auto-create)
    input_q = gpu_queue[Data, 512]
    stage1_to_2 = gpu_queue[Data, 512]
    stage2_to_3 = gpu_queue[Data, 512]
    output_q = gpu_queue[Data, 512]
    
    # Launch pipeline stages
    print("Launching 3-stage pipeline...")
    gpu[4, 32] stage_preprocess(input_q, stage1_to_2)
    gpu[8, 32] stage_compute(stage1_to_2, stage2_to_3)
    gpu[4, 32] stage_postprocess(stage2_to_3, output_q)
    print("  Stage 1: Preprocess  (128 threads)")
    print("  Stage 2: Compute     (256 threads)")
    print("  Stage 3: Postprocess (128 threads)")
    print("")
    
    # Feed data
    print("Processing", n_items, "items...")
    for (i = 0; i < n_items; i = i + 1) {
        data = Data(i, float(i))
        enqueue_host(input_q, data)
    }
    
    # Collect results
    correct = 0
    for (i = 0; i < n_items; i = i + 1) {
        result = dequeue_host(output_q)
        if (result.id == i) {
            correct = correct + 1
        }
        
        if (i < 5) {
            print("  Result", result.id, ":", result.value)
        }
    }
    
    # Shutdown
    print("")
    print("Shutting down pipeline...")
    stop = Data(-1, 0.0)
    enqueue_host(input_q, stop)
    enqueue_host(stage1_to_2, stop)
    enqueue_host(stage2_to_3, stop)
    
    print("")
    print("=== Summary ===")
    print("Items processed:", n_items)
    print("Correct:", correct)
    print("Accuracy:", (float(correct) / float(n_items)) * 100.0, "%")
    print("")
    print("✓ Pipeline complete!")
}

main()

