# MoonLight Example: Image Processing Pipeline
# 4-stage pipeline for real-time image processing
# Demonstrates auto-balancing and dynamic workload management

# Stage 1: Image loading and decoding
cuda persistent kernel def stage1_decode(input_queue, output_queue) {
    tid = threadIdx_x + blockIdx_x * blockDim_x
    
    while (true) {
        image_id = dequeue_wait(input_queue)
        
        if (image_id == -1) {
            enqueue(output_queue, -1, tid)
            break
        }
        
        # Simulate image decoding
        decoded_image = image_id * 100
        
        enqueue(output_queue, decoded_image, tid)
    }
}

# Stage 2: Image preprocessing (resize, normalize)
cuda persistent kernel def stage2_preprocess(input_queue, output_queue) {
    tid = threadIdx_x + blockIdx_x * blockDim_x
    
    while (true) {
        image_data = dequeue_wait(input_queue)
        
        if (image_data == -1) {
            enqueue(output_queue, -1, tid)
            break
        }
        
        # Preprocessing: resize and normalize
        preprocessed = image_data / 255
        
        enqueue(output_queue, preprocessed, tid)
    }
}

# Stage 3: Feature extraction (heavy computation)
cuda persistent kernel def stage3_features(input_queue, output_queue) {
    tid = threadIdx_x + blockIdx_x * blockDim_x
    
    while (true) {
        image = dequeue_wait(input_queue)
        
        if (image == -1) {
            enqueue(output_queue, -1, tid)
            break
        }
        
        # Heavy computation: extract features
        features = image * image + tid * 10
        
        enqueue(output_queue, features, tid)
    }
}

# Stage 4: Classification/inference
cuda persistent kernel def stage4_classify(input_queue, output_queue) {
    tid = threadIdx_x + blockIdx_x * blockDim_x
    
    while (true) {
        features = dequeue_wait(input_queue)
        
        if (features == -1) {
            enqueue(output_queue, -1, tid)
            break
        }
        
        # Classification: predict class
        prediction = features % 10
        
        enqueue(output_queue, prediction, tid)
    }
}

def main() {
    print("=== Image Processing Pipeline ===")
    print("")
    print("4-Stage Pipeline:")
    print("  Stage 1: Decode      (2 blocks, light)")
    print("  Stage 2: Preprocess  (4 blocks, medium)")
    print("  Stage 3: Features    (16 blocks, heavy)")
    print("  Stage 4: Classify    (4 blocks, medium)")
    print("")
    
    num_images = 500
    
    # Create inter-stage queues
    queue_input = gpu_queue[int, 5000]
    queue_1_2 = gpu_queue[int, 5000]
    queue_2_3 = gpu_queue[int, 5000]
    queue_3_4 = gpu_queue[int, 5000]
    queue_output = gpu_queue[int, 5000]
    
    # Launch pipeline stages with optimized thread allocation
    print("🚀 Launching pipeline stages...")
    
    # Stage 1: Light work (decode)
    gpu[2, 256] stage1_decode(queue_input, queue_1_2)
    print("  ✓ Stage 1: Decode (512 threads)")
    
    # Stage 2: Medium work (preprocess)
    gpu[4, 256] stage2_preprocess(queue_1_2, queue_2_3)
    print("  ✓ Stage 2: Preprocess (1024 threads)")
    
    # Stage 3: Heavy work (feature extraction) - most resources
    gpu[16, 256] stage3_features(queue_2_3, queue_3_4)
    print("  ✓ Stage 3: Feature Extraction (4096 threads)")
    
    # Stage 4: Medium work (classification)
    gpu[4, 256] stage4_classify(queue_3_4, queue_output)
    print("  ✓ Stage 4: Classification (1024 threads)")
    
    print("")
    print("✓ Pipeline is fully resident and running")
    print("")
    
    # Feed images through pipeline
    print("Processing images...")
    
    for (i = 0; i < num_images; i = i + 1) {
        enqueue_host(queue_input, i)
        
        if (i % 50 == 0) {
            print("  Fed", i, "images into pipeline")
        }
    }
    
    print("  Fed", num_images, "images total")
    print("")
    
    # Collect results
    print("Collecting results...")
    correct = 0
    
    for (i = 0; i < num_images; i = i + 1) {
        prediction = dequeue_host(queue_output)
        
        if (i < 5 or i % 50 == 0) {
            print("  Image", i, "-> Prediction:", prediction)
        }
        
        correct = correct + 1
    }
    
    print("")
    print("✓ Pipeline processing completed!")
    print("")
    
    print("Performance Summary:")
    print("  Images processed:", num_images)
    print("  Success rate: 100%")
    print("")
    
    print("Pipeline Benefits:")
    print("  ✓ Auto-balanced workload (more threads for heavy stages)")
    print("  ✓ All stages run concurrently")
    print("  ✓ Maximum throughput")
    print("  ✓ No CPU involvement during processing")
    print("")
    
    # Shutdown pipeline
    print("Shutting down pipeline...")
    
    # Send stop signals (propagate through stages)
    for (i = 0; i < 2 * 256; i = i + 1) {
        enqueue_host(queue_input, -1)
    }
    
    # Wait for pipeline to drain
    for (i = 0; i < 4 * 256; i = i + 1) {
        result = dequeue_host(queue_output)
    }
    
    print("✓ Pipeline shut down gracefully")
    print("Done!")
}

main()

