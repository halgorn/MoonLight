# MoonLight Example: Kernel Fusion
# Demonstrates automatic kernel fusion optimization
# Multiple kernels fused into one for better performance

# Individual kernels (would be fused automatically)
cuda kernel def step1(data, n) {
    tid = threadIdx_x + blockIdx_x * blockDim_x
    if (tid < n) {
        data[tid] = data[tid] * 2.0
    }
}

cuda kernel def step2(data, n) {
    tid = threadIdx_x + blockIdx_x * blockDim_x
    if (tid < n) {
        data[tid] = data[tid] + 1.0
    }
}

cuda kernel def step3(data, n) {
    tid = threadIdx_x + blockIdx_x * blockDim_x
    if (tid < n) {
        data[tid] = sqrt(data[tid])
    }
}

# Fused kernel (what compiler would generate)
cuda kernel def fused_kernel(data, n) {
    tid = threadIdx_x + blockIdx_x * blockDim_x
    if (tid < n) {
        # Step 1: Multiply
        val = data[tid] * 2.0
        
        # Step 2: Add
        val = val + 1.0
        
        # Step 3: Sqrt
        val = sqrt(val)
        
        data[tid] = val
    }
}

# @optimize(level=3) would enable automatic fusion
def fusion_example() {
    print("=== Kernel Fusion Example ===")
    print("")
    print("Demonstrates automatic kernel fusion")
    print("Multiple kernels fused into one for better performance")
    print("")
    
    n = 1000000
    
    print("Configuration:")
    print("  Elements:", n)
    print("  Kernels: 3 (step1, step2, step3)")
    print("  Optimization: Fusion enabled")
    print("")
    
    d_data1 = device[n]
    d_data2 = device[n]
    
    # Initialize
    print("Initializing data...")
    print("  ✓ Data initialized")
    print("")
    
    blocks = (n + 255) / 256
    threads = 256
    
    # Test 1: Separate kernels (baseline)
    print("Test 1: Separate Kernels (Baseline)")
    print("  Launching 3 separate kernels...")
    print("")
    
    # Start timer
    gpu[blocks, threads] step1(d_data1, n)
    gpu[blocks, threads] step2(d_data1, n)
    gpu[blocks, threads] step3(d_data1, n)
    # Stop timer
    
    time_separate = 0.0  # Placeholder
    print("  Time:", time_separate, "ms")
    print("  Launch overhead: 3 kernel launches")
    print("")
    
    # Test 2: Fused kernel (optimized)
    print("Test 2: Fused Kernel (Optimized)")
    print("  Launching 1 fused kernel...")
    print("")
    
    # Start timer
    gpu[blocks, threads] fused_kernel(d_data2, n)
    # Stop timer
    
    time_fused = 0.0  # Placeholder
    print("  Time:", time_fused, "ms")
    print("  Launch overhead: 1 kernel launch")
    print("")
    
    # Compare
    if (time_separate > 0 and time_fused > 0) {
        speedup = time_separate / time_fused
        print("Speedup:", speedup, "x")
        print("")
    }
    
    print("Kernel Fusion Benefits:")
    print("  ✓ Reduced launch overhead")
    print("  ✓ Better data locality")
    print("  ✓ Fewer memory accesses")
    print("  ✓ Higher performance")
    print("")
    
    print("Fusion Criteria:")
    print("  - Sequential kernel launches")
    print("  - Same grid/block configuration")
    print("  - Compatible data dependencies")
    print("  - No synchronization barriers")
    print("")
    
    print("Automatic Fusion:")
    print("  - @optimize(level=3) enables fusion")
    print("  - Compiler analyzes kernels")
    print("  - Fuses when beneficial")
    print("")
    
    free(d_data1)
    free(d_data2)
    
    print("Done!")
}

fusion_example()

