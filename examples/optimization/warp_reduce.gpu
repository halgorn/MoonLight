def main() {
    print("=== Warp-Level Reduction ===")
    print("")
    print("Demonstrates warp-level primitives for efficient reductions")
    print("Uses warp shuffle for fast communication")
    print("")
    
    n = 10000
    
    print("Configuration:")
    print("  Elements:", n)
    print("  Warp size: 32 threads")
    print("  Reduction: Sum")
    print("")
    
    # Allocate data
    d_input = device[n]
    d_output = device[(n + 31) / 32]  # One result per warp
    
    # Initialize (in real app: cudaMemcpy)
    print("Initializing data...")
    print("")
    
    # Launch warp reduction
    print("Launching warp-level reduction...")
    blocks = (n + 255) / 256
    threads = 256
    
    gpu[blocks, threads] warp_reduce_kernel(d_input, d_output, n)
    
    print("✓ Warp reduction completed")
    print("")
    
    print("Warp Primitives:")
    print("  - lane_id(): Thread ID within warp (0-31)")
    print("  - warp_id(): Warp ID within block")
    print("  - warp_reduce_sum(): Reduction within warp")
    print("  - warp_shuffle(): Data shuffle within warp")
    print("")
    
    print("Benefits:")
    print("  ✓ Fast communication (register-to-register)")
    print("  ✓ No shared memory needed for warp ops")
    print("  ✓ Efficient reductions")
    print("  ✓ Lower latency than shared memory")
    print("")
    
    print("Use Cases:")
    print("  - Parallel reductions")
    print("  - Scan operations")
    print("  - Data shuffling")
    print("  - Warp-level algorithms")
    print("")
    
    free(d_input)
    free(d_output)
    
    print("Done!")
}

main()

