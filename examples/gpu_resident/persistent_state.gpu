# MoonLight Example: Persistent State on GPU
# Demonstrates maintaining state across multiple function calls
# Perfect for iterative algorithms, simulations, games

# GPU-resident state variables
# These persist across all function calls
gpu_resident d_simulation_state = device[1000000]  # Simulation state
gpu_resident d_accumulator = device[1000]          # Accumulated values
gpu_resident d_iteration_count = device[1]        # Counter

cuda kernel def update_simulation(state, accumulator, iteration, n) {
    tid = threadIdx_x + blockIdx_x * blockDim_x
    
    if (tid < n) {
        # Update simulation state
        state[tid] = state[tid] * 1.01 + tid * 0.001
        
        # Accumulate values
        if (tid < 1000) {
            accumulator[tid] = accumulator[tid] + state[tid]
        }
    }
    
    # Update iteration counter (thread 0)
    if (tid == 0) {
        iteration[0] = iteration[0] + 1
    }
}

def initialize_simulation() {
    print("Initializing simulation state on GPU...")
    
    # Initialize state (in real app: cudaMemcpy or kernel)
    # State is GPU-resident - persists forever!
    
    print("✓ Simulation state initialized")
    print("  State will persist across all iterations")
}

def run_simulation_iteration(iteration_num) {
    print("Running iteration", iteration_num, "...")
    
    # Update simulation using GPU-resident state
    # No need to transfer state to/from CPU!
    
    blocks = 1000
    threads = 256
    
    gpu[blocks, threads] update_simulation(d_simulation_state, d_accumulator, d_iteration_count, 1000000)
    
    print("  ✓ Iteration", iteration_num, "complete")
    print("  ✓ State updated in-place on GPU")
    print("  ✓ No CPU↔GPU transfer needed!")
}

def get_simulation_stats() {
    print("Getting simulation statistics...")
    
    # Read iteration count (only if needed)
    # Most data stays on GPU!
    
    print("  Iteration count stored in GPU-resident memory")
    print("  Can be read when needed (minimal transfer)")
}

def main() {
    print("=== Persistent State on GPU ===")
    print("")
    print("Demonstrates maintaining state across function calls")
    print("Perfect for iterative algorithms and simulations")
    print("")
    
    # Initialize once
    initialize_simulation()
    print("")
    
    # Run multiple iterations
    # State persists between calls!
    
    print("Running simulation iterations...")
    print("")
    
    num_iterations = 10
    
    for (iter = 0; iter < num_iterations; iter = iter + 1) {
        run_simulation_iteration(iter + 1)
        print("")
    }
    
    # Get stats (optional - only if CPU needs them)
    get_simulation_stats()
    print("")
    
    print("=== Benefits ===")
    print("")
    print("Traditional approach:")
    print("  - Per iteration: Transfer state CPU→GPU (10-50ms)")
    print("  - Per iteration: Transfer state GPU→CPU (10-50ms)")
    print("  - Total overhead: 20-100ms per iteration")
    print("")
    
    print("GPU-Resident approach:")
    print("  - Initialization: Transfer state CPU→GPU ONCE (10-50ms)")
    print("  - Per iteration: 0ms transfer (state stays on GPU)")
    print("  - Total overhead: 10-50ms for all iterations")
    print("")
    
    print("Speedup: 10-20x faster for iterative algorithms!")
    print("")
    
    print("Use Cases:")
    print("  ✓ Iterative solvers (conjugate gradient, etc.)")
    print("  ✓ Physics simulations")
    print("  ✓ Game state (particles, physics)")
    print("  ✓ Optimization algorithms")
    print("  ✓ Any algorithm with persistent state")
    print("")
    
    print("Done!")
}

main()

