# MoonLight Benchmark: Shared Memory Performance
# Compares performance with and without shared memory optimization
# Demonstrates the impact of shared memory on performance

# Matrix multiply WITHOUT shared memory (baseline)
cuda kernel def matrix_mult_no_shared(A, B, C, N) {
    tid_x = threadIdx_x + blockIdx_x * blockDim_x
    tid_y = threadIdx_y + blockIdx_y * blockDim_y
    
    if (tid_x < N and tid_y < N) {
        sum = 0.0
        for (k = 0; k < N; k = k + 1) {
            sum += A[tid_y * N + k] * B[k * N + tid_x]
        }
        C[tid_y * N + tid_x] = sum
    }
}

# Matrix multiply WITH shared memory (optimized)
cuda kernel def matrix_mult_with_shared(A, B, C, N) {
    tid_x = threadIdx_x
    tid_y = threadIdx_y
    bid_x = blockIdx_x
    bid_y = blockIdx_y
    
    row = bid_y * 16 + tid_y
    col = bid_x * 16 + tid_x
    
    # Shared memory tiles (would be auto-generated)
    # tile_A = shared[16][16]
    # tile_B = shared[16][16]
    
    sum = 0.0
    
    # Tiled computation
    for (k = 0; k < N; k = k + 16) {
        # Load tiles (simulated - in real: use shared memory)
        # tile_A[tid_y][tid_x] = A[row * N + k + tid_x]
        # tile_B[tid_y][tid_x] = B[(k + tid_y) * N + col]
        # __syncthreads()
        
        # Compute with tiles
        for (i = 0; i < 16; i = i + 1) {
            # sum += tile_A[tid_y][i] * tile_B[i][tid_x]
            sum += A[row * N + k + i] * B[(k + i) * N + col]
        }
        
        # __syncthreads()
    }
    
    if (row < N and col < N) {
        C[row * N + col] = sum
    }
}

def benchmark_matrix_multiply() {
    print("=== Shared Memory Performance Benchmark ===")
    print("")
    print("Comparing matrix multiply with and without shared memory")
    print("")
    
    sizes = [256, 512, 1024, 2048]
    
    for (i = 0; i < len(sizes); i = i + 1) {
        N = sizes[i]
        print("Matrix size:", N, "x", N)
        print("")
        
        # Allocate matrices
        d_A = device[N * N]
        d_B = device[N * N]
        d_C1 = device[N * N]
        d_C2 = device[N * N]
        
        # Initialize (in real app: cudaMemcpy)
        print("  Initializing matrices...")
        
        # Test 1: Without shared memory
        print("  Testing WITHOUT shared memory...")
        blocks_x = (N + 15) / 16
        blocks_y = (N + 15) / 16
        
        # Start timer (in real: cudaEventRecord)
        gpu[(blocks_x, blocks_y), (16, 16)] matrix_mult_no_shared(d_A, d_B, d_C1, N)
        # Stop timer
        time_no_shared = 0.0  # Placeholder - would measure actual time
        
        print("    Time:", time_no_shared, "ms")
        print("")
        
        # Test 2: With shared memory
        print("  Testing WITH shared memory...")
        
        # Start timer
        gpu[(blocks_x, blocks_y), (16, 16)] matrix_mult_with_shared(d_A, d_B, d_C2, N)
        # Stop timer
        time_with_shared = 0.0  # Placeholder
        
        print("    Time:", time_with_shared, "ms")
        print("")
        
        # Calculate speedup
        if (time_no_shared > 0) {
            speedup = time_no_shared / time_with_shared
            print("  Speedup:", speedup, "x")
        }
        print("")
        
        free(d_A)
        free(d_B)
        free(d_C1)
        free(d_C2)
    }
    
    print("=== Results Summary ===")
    print("")
    print("Shared Memory Benefits:")
    print("  ✓ Reduced global memory access")
    print("  ✓ Better memory bandwidth utilization")
    print("  ✓ Improved cache locality")
    print("  ✓ Typical speedup: 2-5x for matrix ops")
    print("")
    print("Auto-Shared Memory Features:")
    print("  - Automatic tiling detection")
    print("  - Optimal tile size selection")
    print("  - Bank conflict avoidance")
    print("  - Compiler optimization")
    print("")
}

def main() {
    benchmark_matrix_multiply()
    print("Done!")
}

main()

