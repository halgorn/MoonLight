{
  "name": "moonlight-language",
  "displayName": "MoonLight Language Support",
  "description": "Syntax highlighting and language support for MoonLight (.gpu files)",
  "version": "1.0.0",
  "publisher": "moonlight",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "moonlight",
        "aliases": ["MoonLight", "moonlight"],
        "extensions": [".gpu"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "moonlight",
        "scopeName": "source.moonlight",
        "path": "./syntaxes/moonlight.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "moonlight",
        "path": "./snippets/moonlight.json"
      }
    ],
    "commands": [
      {
        "command": "moonlight.run",
        "title": "Run MoonLight File"
      },
      {
        "command": "moonlight.compile",
        "title": "Compile MoonLight File"
      }
    ],
    "keybindings": [
      {
        "command": "moonlight.run",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "editorLangId == moonlight"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map"
  },
  "devDependencies": {
    "@types/vscode": "^1.70.0",
    "typescript": "^4.8.0",
    "webpack": "^5.74.0",
    "webpack-cli": "^4.10.0"
  }
}









